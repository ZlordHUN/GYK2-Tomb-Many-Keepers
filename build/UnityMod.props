<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)../</RepositoryRoot>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(RepositoryRoot)GYK2</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/BepInEx</BepInExDir>
    <ManagedDir>$(GameDir)/GraveyardKeeper2_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx;0Harmony">
      <HintPath>$(BepInExDir)/core/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp;LazyBearTechnology;UnityEngine;UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')"
           Text="Game DLLs not found at $(ManagedDir). Set GameDir in build/Local.props or pass -p:GameDir=/path/to/game." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll') Or !Exists('$(BepInExDir)/core/0Harmony.dll')"
           Text="BepInEx 5 core DLLs not found at $(BepInExDir)/core. Set BepInExDir in build/Local.props or pass -p:BepInExDir=/path/to/BepInEx." />
  </Target>
</Project>
